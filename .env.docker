# ============================================================
# Tarot Web App — Docker Environment Variables Template
# Copy file này thành .env (ở thư mục gốc) rồi điền giá trị thật
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=tarot_user
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=tarot_db

# ── LLM — chọn ít nhất 1 (không có key → bản đọc mẫu tự động) ──
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_READING_EFFORT=medium

# ── Backend ──────────────────────────────────────────────────
TAVILY_API_KEY=
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
APP_ENV=production

# ── Quantum RNG ──────────────────────────────────────────────
ANU_QRNG_URL=https://qrng.anu.edu.au/API/jsonI.php
ANU_API_KEY=

# ── Frontend ─────────────────────────────────────────────────
# Để trống: frontend gọi /api cùng domain qua nginx (khuyến nghị).
# Chỉ đặt khi API nằm ở domain khác (VD: https://api.tarot.yourdomain.com),
# và nhớ thêm domain frontend vào CORS_ORIGINS của backend.
NEXT_PUBLIC_API_URL=
