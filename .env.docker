# ============================================================
# Tarot Web App — Docker Environment Variables Template
# Copy file này thành .env rồi điền giá trị thật
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=tarot_user
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=tarot_db

# ── Backend ──────────────────────────────────────────────────
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
APP_ENV=production

# ── Quantum RNG ──────────────────────────────────────────────
ANU_QRNG_URL=https://qrng.anu.edu.au/API/jsonI.php

# ── Frontend ─────────────────────────────────────────────────
# Trong production, đổi thành domain thật (VD: https://tarot.yourdomain.com)
NEXT_PUBLIC_API_URL=http://localhost:80
