# ============================================================
# .gitignore — Quantum Tarot App (FastAPI + Next.js + Docker)
# ============================================================


# ─── Python / FastAPI ────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python

# Virtual environments
venv/
.venv/
env/
ENV/
backend/venv/

# Coverage & testing
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
nosetests.xml
coverage.xml
*.cover

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# Alembic (chỉ ignore autogenerated, giữ lại migrations/versions/)
# (bỏ comment dòng dưới nếu muốn ignore toàn bộ migrations)
# backend/migrations/versions/


# ─── Node.js / Next.js ───────────────────────────────────────
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Next.js build output
frontend/.next/
frontend/out/
frontend/build/
next-env.d.ts

# Vercel
.vercel

# TypeScript incremental build
*.tsbuildinfo


# ─── Environment & Secrets (QUAN TRỌNG) ─────────────────────
.env
.env.*
!.env.example
!.env.docker
!.env.docker.example

# Backend specific
backend/.env
backend/.env.*
!backend/.env.example

# Frontend specific
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
!frontend/.env.example


# ─── Database ────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
pgdata/
postgres-data/


# ─── Docker local overrides ──────────────────────────────────
docker-compose.override.yml
docker-compose.local.yml
.docker/


# ─── IDE / Editor ────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/


# ─── OS ──────────────────────────────────────────────────────
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini


# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
*.log.*
pip-log.txt


# ─── Cache ───────────────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
.stylelintcache


# ─── Misc ────────────────────────────────────────────────────
*.bak
*.tmp
*.orig
*.patch

# Claude Code
.claude/

# Tavily fetched data (có thể regenerate bằng fetch_tavily_data.py)
backend/tarot_seed_data.json
