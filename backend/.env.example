# ============================================================
# Tarot Web App - Environment Variables Example
# Copy this file to .env and fill in your values.
# ============================================================

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://tarot_user:tarot_pass@localhost:5432/tarot_db

# --- Tavily Search API ---
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Anthropic Claude AI ---
ANTHROPIC_API_KEY=

# --- ANU QRNG (Quantum Random Number Generator) ---
# Free API: https://qrng.anu.edu.au/
ANU_QRNG_URL=https://qrng.anu.edu.au/API/jsonI.php

# --- App Settings ---
APP_ENV=development
SECRET_KEY=change-this-to-a-very-secret-key-in-production
