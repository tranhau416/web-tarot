# ============================================================
# Tarot Web App - Environment Variables Example (local dev)
# Copy this file to .env and fill in your values.
# (Docker Compose dùng file .env ở thư mục gốc — xem .env.docker)
# ============================================================

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://tarot_user:tarot_pass@localhost:5432/tarot_db
# Tự tạo bảng + seed 78 lá khi backend khởi động (nếu DB còn thiếu)
AUTO_INIT_DB=true

# --- LLM — chọn ít nhất 1 (nếu không có sẽ dùng bản đọc mẫu) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Độ sâu suy nghĩ của Claude: low | medium | high | xhigh | max
CLAUDE_READING_EFFORT=medium

# --- Tavily Search API (tuỳ chọn, cho fetch_tavily_data.py) ---
TAVILY_API_KEY=

# --- ANU QRNG (Quantum Random Number Generator) ---
# Lấy key tại https://quantumnumbers.anu.edu.au (gói miễn phí ~100 request/tháng; gói trả phí qua AWS Marketplace).
# ANU_QRNG_URL để trống = tự chọn: có ANU_API_KEY → https://api.quantumnumbers.anu.edu.au,
# không có → API cũ https://qrng.anu.edu.au/API/jsonI.php (không cần key, đang bị thu hẹp dần).
ANU_QRNG_URL=
ANU_API_KEY=
ENTROPY_TIMEOUT_SECONDS=4
# Byte lấy sẵn mỗi lần gọi (tối đa 1024); một lượt rút dùng 18–36 byte → ~30–45 lượt mỗi request
ENTROPY_POOL_BYTES=1024

# --- HTTP ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- App Settings ---
APP_ENV=development
SECRET_KEY=change-this-to-a-very-secret-key-in-production
